{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugins.dprint.dev/dprint/dprint-plugin-csharpier/0.0.0/schema.json",
  "type": "object",
  "x-playground": {
    "input": [
      "using System;using System.Collections.Generic;",
      "using System.Linq;",
      "",
      "namespace Inventory   {",
      "public record Item(string Name,decimal Price,int Quantity);",
      "",
      "public class Warehouse{",
      "    private readonly List<Item> items=new();",
      "  public void Add(Item item){if(item.Quantity<0){throw new ArgumentException(\"Quantity can't be negative\",nameof(item));}",
      "  items.Add(item);}",
      "    public decimal TotalValue()=>items.Sum(i=>i.Price*i.Quantity);",
      "",
      "  public IEnumerable<string> LowStock(int threshold=5)",
      "  {",
      "      return items.Where(i=>i.Quantity<threshold).OrderBy(i=>i.Name).Select(i=>$\"{i.Name} ({i.Quantity} left)\");",
      "  }",
      "}",
      "}"
    ]
  },
  "definitions": {
    "lineWidth": {
      "description": "The width of a line the printer will try to stay under. Note that the printer may exceed this width in certain cases.",
      "type": "integer",
      "minimum": 1
    },
    "indentWidth": {
      "description": "The number of characters for an indent.",
      "type": "integer",
      "minimum": 1
    },
    "useTabs": {
      "description": "Whether to use tabs (true) or spaces (false).",
      "type": "boolean",
      "oneOf": [
        {
          "const": true,
          "description": "Uses tabs for indentation."
        },
        {
          "const": false,
          "description": "Uses spaces for indentation."
        }
      ]
    },
    "newLineKind": {
      "description": "The kind of newline to use.",
      "type": "string",
      "oneOf": [
        {
          "const": "auto",
          "description": "For each file, uses the newline kind found at the end of the last line."
        },
        {
          "const": "crlf",
          "description": "Uses carriage return, line feed."
        },
        {
          "const": "lf",
          "description": "Uses line feed."
        },
        {
          "const": "system",
          "description": "Uses line feed, because the plugin is unable to see the system standard."
        }
      ]
    }
  },
  "properties": {
    "locked": {
      "description": "Whether the configuration is not allowed to be overriden or extended.",
      "type": "boolean"
    },
    "lineWidth": {
      "$ref": "#/definitions/lineWidth"
    },
    "indentWidth": {
      "$ref": "#/definitions/indentWidth"
    },
    "useTabs": {
      "$ref": "#/definitions/useTabs",
      "x-example": {
        "input": [
          "class Counter",
          "{",
          "    int count;",
          "}"
        ]
      }
    },
    "newLineKind": {
      "$ref": "#/definitions/newLineKind"
    },
    "csharp.lineWidth": {
      "$ref": "#/definitions/lineWidth",
      "default": 100,
      "x-overrides": "lineWidth"
    },
    "csharp.indentWidth": {
      "$ref": "#/definitions/indentWidth",
      "default": 4,
      "x-overrides": "indentWidth"
    },
    "csharp.useTabs": {
      "$ref": "#/definitions/useTabs",
      "default": false,
      "x-overrides": "useTabs"
    },
    "csharp.newLineKind": {
      "$ref": "#/definitions/newLineKind",
      "default": "auto",
      "x-overrides": "newLineKind"
    },
    "xml.lineWidth": {
      "$ref": "#/definitions/lineWidth",
      "default": 100,
      "x-overrides": "lineWidth"
    },
    "xml.indentWidth": {
      "$ref": "#/definitions/indentWidth",
      "default": 2,
      "x-overrides": "indentWidth"
    },
    "xml.useTabs": {
      "$ref": "#/definitions/useTabs",
      "default": false,
      "x-overrides": "useTabs"
    },
    "xml.newLineKind": {
      "$ref": "#/definitions/newLineKind",
      "default": "auto",
      "x-overrides": "newLineKind"
    },
    "includeGenerated": {
      "description": "Whether to format generated files, which are files with a name like `*.g.cs` or `*.designer.cs` and C# files that start with an `<auto-generated>` comment.",
      "type": "boolean",
      "default": false,
      "oneOf": [
        {
          "const": true,
          "description": "Formats generated files."
        },
        {
          "const": false,
          "description": "Leaves generated files as they are."
        }
      ],
      "x-example": {
        "input": [
          "// <auto-generated />",
          "class Generated{int value;}"
        ]
      }
    },
    "xmlWhitespaceSensitivity": {
      "description": "How whitespace in the text of XML elements is handled. Defaults to `ignore` for `.xaml` and `.axaml` files and `strict` for other files.",
      "type": "string",
      "oneOf": [
        {
          "const": "strict",
          "description": "Keeps the whitespace in text because it may be significant."
        },
        {
          "const": "ignore",
          "description": "Formats the whitespace in text."
        }
      ],
      "x-example": {
        "extension": "xml",
        "input": [
          "<Page>",
          "  <Title>  Order   summary  </Title>",
          "</Page>"
        ]
      }
    }
  }
}
